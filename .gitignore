/.thrn-reports/
*.log
*.tmp

# Private editor state
.vscode/*.code-workspace
.vscode/*.local.json
.vscode/.history/
.idea/
*.iml

# macOS filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
._*
